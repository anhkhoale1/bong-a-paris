PORT=3000
# Use the frontend origin printed by the Vite dev server.
FRONTEND_URL=your-local-frontend-origin
# Find the local connection string in docker-compose.yml or your database client.
DATABASE_URL=your-local-postgres-connection-string
ADMIN_EMAIL=admin-local@example.com
ADMIN_PASSWORD=change-this-local-password
JWT_SECRET=replace-with-a-local-secret-of-at-least-32-characters
