PORT=3000
# Find the exact preprod frontend origin in the Cloudflare Worker dashboard.
FRONTEND_URL=your-preprod-frontend-origin
# Find the preprod connection string in the Neon project/branch dashboard.
DATABASE_URL=your-neon-preprod-connection-string
ADMIN_EMAIL=admin-preprod@example.com
ADMIN_PASSWORD=change-this-preprod-password
JWT_SECRET=replace-with-a-different-preprod-secret-of-at-least-32-characters
